  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "id.secret",
        "description": "Frontier API key sent as Authorization: Bearer <id>.<secret>. Store the credential server-side."
      }
    },
    "schemas": {
      "TradingConfig": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "const": 2
          },
          "chainId": {
            "type": "number",
            "const": 4663
          },
          "chainName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "vault": {
            "anyOf": [
              {
                "description": "Nonzero EVM address; mixed-case addresses must have a valid EIP-55 checksum. Normalized to checksum case.",
                "type": "string",
                "minLength": 42,
                "maxLength": 42,
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "explorerUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "format": "uri"
          },
          "encryptionPublicKey": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 66,
                "maxLength": 66,
                "pattern": "^0x[0-9a-fA-F]{64}$",
                "description": "32 bytes of hexadecimal, normalized to lowercase."
              },
              {
                "type": "null"
              }
            ]
          },
          "maxAmount": {
            "type": "string",
            "minLength": 1,
            "maxLength": 39,
            "pattern": "^[1-9][0-9]*$",
            "description": "Canonical decimal integer, 1 through 170141183460469231731687303715884105727, inclusive. No sign, exponent, or leading zeroes."
          },
          "feeBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999
          },
          "minimumBatchSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "batchWindowSeconds": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 86400
          },
          "orderLifetimeSeconds": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 86400
          },
          "defaultSlippageBps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "maxSlippageBps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "paused": {
            "type": "boolean"
          },
          "acceptingOrders": {
            "type": "boolean"
          },
          "service": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "starting",
                  "online",
                  "offline",
                  "degraded"
                ]
              },
              "message": {
                "type": "string",
                "maxLength": 2048
              },
              "lastHeartbeatAt": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Unix timestamp in seconds."
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "state",
              "message",
              "lastHeartbeatAt"
            ]
          }
        },
        "required": [
          "version",
          "chainId",
          "chainName",
          "vault",
          "explorerUrl",
          "encryptionPublicKey",
          "maxAmount",
          "feeBps",
          "minimumBatchSize",
          "batchWindowSeconds",
          "orderLifetimeSeconds",
          "defaultSlippageBps",
          "maxSlippageBps",
          "paused",
          "acceptingOrders",
          "service"
        ]
      },
      "TradingAsset": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Z][A-Z0-9.-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "address": {
            "description": "Nonzero EVM address; mixed-case addresses must have a valid EIP-55 checksum. Normalized to checksum case.",
            "type": "string",
            "minLength": 42,
            "maxLength": 42,
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "logoUrl": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "decimals": {
            "type": "number",
            "const": 18
          },
          "multiplier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 97,
            "pattern": "^(0|[1-9][0-9]*)(?:\\.([0-9]{1,18}))?$",
            "description": "Positive decimal with at most 18 fractional digits; scaled by 10^18 it must fit uint256."
          },
          "enabled": {
            "type": "boolean"
          },
          "unavailableReason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "symbol",
          "name",
          "address",
          "logoUrl",
          "decimals",
          "multiplier",
          "enabled",
          "unavailableReason"
        ]
      },
      "TradingAssetsResponse": {
        "type": "object",
        "properties": {
          "assets": {
            "maxItems": 10000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "^[A-Z][A-Z0-9.-]*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "address": {
                  "description": "Nonzero EVM address; mixed-case addresses must have a valid EIP-55 checksum. Normalized to checksum case.",
                  "type": "string",
                  "minLength": 42,
                  "maxLength": 42,
                  "pattern": "^0x[0-9a-fA-F]{40}$"
                },
                "logoUrl": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "format": "uri"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "decimals": {
                  "type": "number",
                  "const": 18
                },
                "multiplier": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 97,
                  "pattern": "^(0|[1-9][0-9]*)(?:\\.([0-9]{1,18}))?$",
                  "description": "Positive decimal with at most 18 fractional digits; scaled by 10^18 it must fit uint256."
                },
                "enabled": {
                  "type": "boolean"
                },
                "unavailableReason": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 2048
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "symbol",
                "name",
                "address",
                "logoUrl",
                "decimals",
                "multiplier",
                "enabled",
                "unavailableReason"
              ]
            }
          },
          "updatedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Unix timestamp in seconds."
          }
        },
        "required": [
          "assets",
          "updatedAt"
        ]
      },
      "TradingQuoteRequest": {
        "type": "object",
        "properties": {
          "stock": {
            "description": "Nonzero EVM address; mixed-case addresses must have a valid EIP-55 checksum. Normalized to checksum case.",
            "type": "string",
            "minLength": 42,
            "maxLength": 42,
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "side": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ]
          },
          "amount": {
            "type": "string",
            "minLength": 1,
            "maxLength": 39,
            "pattern": "^[1-9][0-9]*$",
            "description": "Canonical decimal integer, 1 through 170141183460469231731687303715884105727, inclusive. No sign, exponent, or leading zeroes."
          },
          "slippageBps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        },
        "required": [
          "stock",
          "side",
          "amount",
          "slippageBps"
        ],
        "additionalProperties": false
      },
      "TradingQuote": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "const": 2
          },
          "chainId": {
            "type": "number",
            "const": 4663
